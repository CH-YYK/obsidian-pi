{
  "name": "note-pi",
  "version": "0.7.2",
  "private": false,
  "description": "Obsidian view backed by an embedded Pi harness runtime, on desktop and mobile",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.mjs",
    "spike:surface": "node scripts/measure-pi-surface.mjs",
    "deploy:testing": "npm run build && node scripts/deploy-testing-vault.mjs",
    "verify:mobile": "node scripts/verify-mobile.mjs",
    "verify": "npm run typecheck && npm run build && npm run test && node scripts/verify-standalone.mjs && node scripts/verify-mobile.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "jiti": "^2.7.0",
    "node-fetch": "^3.3.2",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.1",
    "obsidian": "^1.13.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
